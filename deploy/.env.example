### Local deploy runner config
AWS_REGION=us-east-1
PROJECT_NAME=meridian-support-chatbot
SSH_PRIVATE_KEY_PATH=/absolute/path/to/your-key.pem
SSH_KEY_NAME=
EC2_USER=ubuntu

### Terraform infra config
FRONTEND_INSTANCE_TYPE=t3.small
BACKEND_INSTANCE_TYPE=t3.small
ALLOWED_SSH_CIDR=0.0.0.0/0
AVAILABILITY_ZONE=us-east-1a

### Optional DNS mode (HTTPS)
# Set these if you want domain-based URLs.
FRONTEND_DOMAIN=meridian.home.jaraflytech.com
BACKEND_DOMAIN=api.home.jaraflytech.com
CREATE_ROUTE53_RECORDS=true
HOSTED_ZONE_NAME=home.jaraflytech.com
FRONTEND_SUBDOMAIN=meridian
BACKEND_SUBDOMAIN=api
LETSENCRYPT_EMAIL=admin@home.jaraflytech.com

### If you want IP-only HTTP mode:
# FRONTEND_DOMAIN=
# BACKEND_DOMAIN=
# CREATE_ROUTE53_RECORDS=false
# HOSTED_ZONE_NAME=

### App config
POSTGRES_DB=meridian_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
GUARDRAIL_MODEL=gpt-4o-mini
MCP_SERVER_URL=https://order-mcp-74afyau24q-uc.a.run.app/mcp
AUTH_TOKEN_TTL_SECONDS=3600
MAX_INPUT_CHARS=4000
HISTORY_CONTEXT_LIMIT=30
LOG_LEVEL=INFO
ENABLE_OPENAI_TRACING=true

### Optional override. By default bootstrap sets this to frontend public URL.
# CORS_ALLOWED_ORIGINS=
